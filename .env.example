# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
SIGNAL_CHANNEL_ID=your_signal_channel_id_here
SUMMARY_CHANNEL_ID=your_summary_channel_id_here
# Optional: set this to your server's Guild ID for INSTANT slash command updates (great for testing).
# Leave it unset (or remove it) for global command deployment (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=your_guild_id_here

# Exchange (no API key required — public OHLCV endpoints only)
# Supported values: bybit, okx, gate, binanceusdm
# Default is bybit (globally available). If your server is geo-restricted from
# one exchange the bot will automatically fall back through the priority list.
# Set this to force a specific starting exchange.
EXCHANGE_ID=bybit

# Anthropic (Claude for summaries)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Trading Parameters
# No fixed capital needed — sizing is shown as % of whatever you're allocating
MAX_OPEN_POSITIONS=3        # Max simultaneously tracked positions
MAX_DAILY_LOSS=150          # USD — disables scanning for the day if hit
MIN_SCORE_THRESHOLD=60      # 0-100 — minimum score to post a signal
MAX_LEVERAGE_SCALP=50       # Hard cap for scalp trades (tight SL, 5m/1m timeframe)
MAX_LEVERAGE_SWING=20       # Hard cap for swing trades (wide SL, 15m/4h timeframe)

# Engine
SCAN_INTERVAL_MINUTES=5     # How often to scan for setups
ENABLED=true                # Master on/off switch
