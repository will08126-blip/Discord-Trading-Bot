# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
SIGNAL_CHANNEL_ID=your_signal_channel_id_here
SUMMARY_CHANNEL_ID=your_summary_channel_id_here

# Binance Futures (read-only API key — for market data only)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# Anthropic (Claude for summaries)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Trading Parameters
ACCOUNT_CAPITAL=10000       # USD account size (for position sizing display)
RISK_PER_TRADE=50           # USD max risk per trade
MAX_OPEN_POSITIONS=3        # Max simultaneously tracked positions
MAX_DAILY_LOSS=150          # USD — disables scanning for the day if hit
MAX_DRAWDOWN_PCT=10         # % — disables bot if equity drops this much
MIN_SCORE_THRESHOLD=60      # 0-100 — minimum score to post a signal
MAX_LEVERAGE=20             # Hard leverage cap

# Engine
SCAN_INTERVAL_MINUTES=5     # How often to scan for setups
ENABLED=true                # Master on/off switch
